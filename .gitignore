# data/ в репозитории: видео, кадры, предразметка, выгрузки CVAT, feature store.
# Не храним то, что скачивается или пересобирается:
# веса моделей и HF-кэш (~1 ГБ) — скачиваются при первом запуске
data/cache/
# прогоны обучения
data/runs/
# build-datasets собирает заново из выгрузок CVAT
data/datasets/
data/frames/*/preview*/
data/frames/*/exp_*.json
# кэш предсказаний L1 (python -m cv.infer) — пересобирается за минуты
data/features/*/l1_*.json
# Local source inputs for regenerating the saved preliminary audit reports.
reference/review_observations.py
reference/dataset_manifest.json
